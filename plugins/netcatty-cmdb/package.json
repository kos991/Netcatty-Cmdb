{
  "name": "netcatty-cmdb",
  "displayName": "CMDB 资产管理",
  "version": "1.3.1",
  "description": "Netcatty 官方扩展插件：CMDB 资产与服务器全景管理平台",
  "author": "kos991",
  "license": "MIT",
  "main": "embed_loader.js",
  "categories": [
    "Utility",
    "Productivity",
    "Terminal"
  ],
  "contributions": {
    "views": [
      {
        "id": "cmdb-view",
        "title": "CMDB",
        "icon": "icon.svg",
        "location": "sidebar",
        "targetUrl": "http://127.0.0.1:8080"
      }
    ],
    "commands": [
      {
        "id": "cmdb.openDashboard",
        "title": "打开 CMDB 资产与仪表盘"
      },
      {
        "id": "cmdb.syncHosts",
        "title": "将 CMDB 虚拟机同步至 Netcatty 主机列表"
      },
      {
        "id": "cmdb.scanUosPatches",
        "title": "批量扫描统信 UOS 虚拟机安全补丁"
      },
      {
        "id": "cmdb.scanKylinPatches",
        "title": "批量扫描银河麒麟虚拟机安全补丁"
      }
    ]
  }
}
