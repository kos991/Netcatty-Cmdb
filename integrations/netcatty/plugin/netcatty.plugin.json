{
  "$schema": "../../../packages/plugin-contract/schema/plugin-contract.schema.json",
  "manifestVersion": 1,
  "id": "com.netcatty.cmdb",
  "name": "cmdb-netcatty",
  "displayName": { "en": "CMDB", "zh-CN": "CMDB 资产管理" },
  "description": "CMDB asset search and IP planning for Netcatty.",
  "version": "1.1.0",
  "publisher": "czfy-assets",
  "license": "GPL-3.0-or-later",
  "engines": { "netcatty": ">=0.0.0", "api": ">=0.1.0-internal <0.2.0" },
  "main": { "browser": "dist/index.js" },
  "activationEvents": ["onView:com.netcatty.cmdb.resources"],
  "permissions": {
    "required": [
      "settings.read",
      "settings.write",
      "views",
      {
        "permission": "network",
        "resources": ["http://127.0.0.1:18080"],
        "reason": "读取本机 CMDB 服务中的资产和 IP 规划数据。"
      }
    ],
    "optional": []
  },
  "contributes": {
    "settings": [
      {
        "id": "com.netcatty.cmdb.baseUrl",
        "label": { "en": "CMDB service URL", "zh-CN": "CMDB 服务地址" },
        "description": { "en": "Base URL of the Go CMDB service.", "zh-CN": "Go CMDB 服务的基础地址。" },
        "control": "text",
        "scope": "application",
        "default": "http://127.0.0.1:18080",
        "placeholder": { "en": "http://127.0.0.1:18080", "zh-CN": "http://127.0.0.1:18080" }
      }
    ],
    "views": [
      {
        "id": "com.netcatty.cmdb.resources",
        "title": { "en": "CMDB", "zh-CN": "CMDB" },
        "location": "tab",
        "entry": "dist/view.html",
        "retainContextWhenHidden": true
      }
    ]
  }
}
